# ---------------------------------------------------------------------------
# Openpay
# ---------------------------------------------------------------------------
# Copia este archivo a `.env.local` para desarrollo y carga las mismas
# variables en Vercel (Project → Settings → Environment Variables).
#
# `.env.local` ya está en .gitignore. La llave privada NUNCA va al repositorio
# y NUNCA lleva el prefijo NEXT_PUBLIC_: ese prefijo la publicaría en el bundle
# que descarga el navegador.

# Sandbox mientras valga cualquier cosa distinta de "false".
# Durante la cita de validación técnica tiene que estar en true (punto 2).
NEXT_PUBLIC_OPENPAY_SANDBOX=true

# Panel de Openpay → Configuración. Ambos son públicos.
NEXT_PUBLIC_OPENPAY_MERCHANT_ID=
NEXT_PUBLIC_OPENPAY_PUBLIC_KEY=

# Llave PRIVADA. Sólo servidor.
OPENPAY_PRIVATE_KEY=
# Opcional: por omisión se usa NEXT_PUBLIC_OPENPAY_MERCHANT_ID.
OPENPAY_MERCHANT_ID=

# Base pública del sitio; se usa para armar el redirect_url de 3D Secure.
# En Vercel puede omitirse: se deriva de VERCEL_URL.
NEXT_PUBLIC_SITE_URL=https://www.yaakob.com

# Identificadores de los planes creados en el panel de Openpay (Planes).
NEXT_PUBLIC_OPENPAY_PLAN_VIGILANCIA_MENSUAL=
NEXT_PUBLIC_OPENPAY_PLAN_VIGILANCIA_ANUAL=

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# La Content-Security-Policy arranca en modo reporte. Ponlo en 1 cuando hayas
# revisado los reportes del navegador y quieras que bloquee de verdad.
CSP_ENFORCE=0
